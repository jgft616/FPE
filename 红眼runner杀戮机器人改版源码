-- 性能监控
local perf = {
    last = {}, count = {}, avg = {},
    targets = {
        damageCheck = 0.1, protectionLoop = 0.1, revengeLoop = 0.1,
        selfDamageCheck = 0.1, targetScan = 0.1, teleportCheck = 0.05,
        attackSimulation = 0.05, mainAttackCheck = 0.1
    }
}
function perf:track(n)
    local t = tick()
    local int = t - (self.last[n] or t)
    self.count[n] = (self.count[n] or 0) + 1
    self.last[n] = t
    if not self.avg[n] then self.avg[n] = int else self.avg[n] = self.avg[n] * 0.9 + int * 0.1 end
    return int
end
function perf:shouldRun(n, target)
    if target then self.targets[n] = target end
    local tar = self.targets[n] or target or 0.1
    return (tick() - (self.last[n] or 0)) >= tar
end
function perf:getWait(n, base)
    local a = self.avg[n]
    if a then
        if a > base * 1.2 then return math.max(0.01, base * 0.8)
        elseif a < base * 0.8 then return math.min(0.2, base * 1.2) end
    end
    return base
end

