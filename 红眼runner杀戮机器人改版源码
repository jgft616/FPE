local function stop(reason)
    if target then release(target) end
    if followLoop then followLoop:Disconnect(); followLoop = nil end
    if attackLoop then attackLoop:Disconnect(); attackLoop = nil end
    dmgThread = nil
    if target then removeBillboard(); healthHist[target] = nil end
    target = nil
    tData = nil
    if targetTxt then targetTxt.Text = "目标: 无" end
    if infoTxt then infoTxt.Text = "状态信息" end
end

local function startDmgCheck()
    if dmgThread then dmgThread = nil end
    if not target or not tData then return end
    local lastHealth = nil
    local stopTimer = 0
    local lastDmgTime = 0
    dmgThread = coroutine.create(function()
        while active and target and alive(target) do
            perf:track("damageCheck")
            local h = gHum(target.Character)
            if h then
                local cur = h.Health
                local v = gVel(target.Character)
                local moving = v.Magnitude > 1
                tData.smoothedVelocity = tData.smoothedVelocity:Lerp(v, cfg.PredictionSmoothing)
                if tData.smoothedVelocity.Magnitude > 1 then
                    tData.movingTime = (tData.movingTime or 0) + 0.1
                    local prog = math.min(tData.movingTime / cfg.ChaseThreshold, 1)
                    tData.currentDistance = cfg.BaseDistance + (cfg.MaxDistance - cfg.BaseDistance) * prog
                    tData.isMoving = true
                else
                    tData.movingTime = 0
                    tData.currentDistance = cfg.BaseDistance
                    tData.isMoving = false
                end
                if lastHealth and cur < lastHealth then
                    tData.takingDamage = true
                    lastDmgTime = tick()
                    stopTimer = 0
                else
                    if tData.takingDamage and tick() - lastDmgTime > 2 then
                        tData.takingDamage = false
                    end
                    if moving then stopTimer = 0
                    else
                        stopTimer = stopTimer + cfg.DamageCheckInterval
                        if stopTimer >= cfg.StopThreshold then tData.isMoving = false end
                    end
                end
                lastHealth = cur
                healthHist[target] = cur
            end
            task.wait(perf:getWait("damageCheck", cfg.DamageCheckInterval))
        end
    end)
    coroutine.resume(dmgThread)
end

local function attack(p)
    if not p or not alive(p) then return false end
    if isMain(p) then resetChar("攻击主账号"); return false end
    local isRev = (revengeTarget == p.Name)
    if not isRev and isAttacked(p) then return false end
    if not claim(p) then return false end
    stop("切换中")
    target = p
    tData = {
        smoothedVelocity = Vector3.new(), movingTime = 0,
        currentDistance = cfg.BaseDistance, isMoving = false,
        takingDamage = false
    }
    if targetTxt then targetTxt.Text = "目标: " .. p.Name .. (isRev and " (复仇)" or "") end
    createBillboard(p)
    startDmgCheck()
    followLoop = rs.Stepped:Connect(function()
        if checkLongDmg() then resetChar("长时间受击"); return end
        if checkMainAttack() then resetChar("主账号攻击"); return end
        if selfDmgActive then return end
        if not active then stop("已禁用"); return end
        if not target or not alive(target) then
            local rev = getRevenge()
            if rev then attack(rev)
            elseif queued and alive(queued) then local n = queued; queued = nil; attack(n)
            else stop("目标死亡") end
            return
        end
        if not hasBlocked(LPL) and takingDmg(target) then
            release(target); removeBillboard(); healthHist[target] = nil
            target = nil; tData = nil; return
        end
        local f = falling()
        if f and target then
            local myRoot = gRoot(LPL.Character)
            local tChar = target.Character
            if myRoot and tChar then
                local tRoot = gRoot(tChar)
                if tRoot then
                    local tPos = tRoot.Position
                    local ray = Ray.new(tPos + Vector3.new(0, 5, 0), Vector3.new(0, -10, 0))
                    local hit, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, {LPL.Character, tChar})
                    local groundY = hit and hitPos.Y or tPos.Y
                    myRoot.CFrame = CFrame.new(Vector3.new(tPos.X, groundY + 3, tPos.Z))
                    lastTeleport = tick()
                end
            end
            return
        end
        local now = tick()
        local should = false
        if tData then
            if tData.isMoving and not tData.takingDamage then should = true
            elseif not tData.isMoving and not tData.takingDamage and (now - lastTeleport) >= 2 then should = true end
        end
        if should and now - lastTeleport >= cfg.TeleportCooldown then
            pcall(function()
                local myRoot = gRoot(LPL.Character)
                local tChar = target.Character
                if myRoot and tChar then
                    local b = behindPos(tChar, tData.currentDistance)
                    if b then
                        local ray = Ray.new(b + Vector3.new(0, 5, 0), Vector3.new(0, -10, 0))
                        local hit, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, {LPL.Character, tChar})
                        local groundY = hit and hitPos.Y or b.Y
                        local final = Vector3.new(b.X, groundY + 3, b.Z)
                        if cfg.SmoothTeleports then
                            local tween = ts:Create(myRoot, TweenInfo.new(distPos(myRoot.Position, final) / cfg.TeleportSpeed), {CFrame = CFrame.new(final)})
                            tween:Play()
                        else
                            myRoot.CFrame = CFrame.new(final)
                        end
                        lastTeleport = now
                    end
                end
            end)
        end
    end)
    attackLoop = rs.Heartbeat:Connect(function()
        if selfDmgActive or not active or not target or not alive(target) then return end
        pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.One, false, nil)
            vim:SendMouseButtonEvent(0, 0, 0, true, nil, 1)
            task.wait(0.01)
            vim:SendKeyEvent(false, Enum.KeyCode.One, false, nil)
            vim:SendMouseButtonEvent(0, 0, 0, false, nil, 1)
        end)
        task.wait(perf:getWait("attackSimulation", cfg.AttackRate))
    end)
    return true
end

local function findBest()
    local best, bestScore = nil, -1
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LPL and not isMain(p) and alive(p) then
            if targetFree(p) and not isAttacked(p) then
                local d = dist(p)
                if d <= cfg.Radius then
                    local h = gHum(p.Character)
                    local hp = h and h.Health or 100
                    local s = (1000 / d) + (100 - hp)
                    if s > bestScore then bestScore = s; best = p end
                end
            end
        end
    end
    return best
end

local function startNormal()
    spawn(function()
        while active do
            perf:track("targetScan")
            if not target and not selfDmgActive then
                local p = findBest()
                if p then attack(p) end
            end
            task.wait(perf:getWait("targetScan", 0.1))
        end
    end)
end

local function startRevLoop()
    spawn(function()
        while active do
            perf:track("revengeLoop")
            local rev = getRevenge()
            if rev then
                if not target or target ~= rev then
                    if target then stop("复仇切换") end
                    attack(rev)
                end
            end
            task.wait(perf:getWait("revengeLoop", 0.1))
        end
    end)
end

local function startMainCheckLoop()
    spawn(function()
        while active do
            if checkMainAttack() then resetChar("主账号攻击") end
            task.wait(0.1)
        end
    end)
end

local function startProtection()
    startRevLoop()
    startMainCheckLoop()
    task.wait(1)
    teleNearMain()
    spawn(function()
        while active do
            perf:track("protectionLoop")
            local m = getMain()
            if m and m.Character then
                local deathPos = nil
                local mRoot = gRoot(m.Character)
                if mRoot then deathPos = mRoot.Position end
                local mAlive = alive(m)
                if mainWasAlive and not mAlive and not mainDeadProcessed then
                    mainDeadProcessed = true
                    local killer = findMainKiller(deathPos)
                    if killer then
                        setRevenge(killer)
                        if target then stop("复仇切换") end
                        attack(killer)
                    end
                end
                mainWasAlive = mAlive
                if mAlive then mainDeadProcessed = false end
                local rev = getRevenge()
                if rev then
                    task.wait(perf:getWait("protectionLoop", 0.1))
                    continue
                end
                local d = distToMain()
                if d > 30 and not target and tick() - lastProtectionTeleport > 3 then
                    teleNearMain()
                end
                local dmg, _ = mainTakingDmg()
                if dmg and not mainDmgResponse then
                    mainDmgResponse = true
                    local e = findClosestEnemyToMain()
                    if e then
                        if target then queued = e else attack(e) end
                    end
                    task.wait(5)
                    mainDmgResponse = false
                end
                if not target and not queued and mRoot then
                    for _, p in ipairs(game.Players:GetPlayers()) do
                        if p ~= LPL and not isMain(p) and alive(p) and targetFree(p) and not isAttacked(p) then
                            local r = gRoot(p.Character)
                            if r and distPos(r.Position, mRoot.Position) <= 30 then
                                attack(p); break
                            end
                        end
                    end
                end
            end
            task.wait(perf:getWait("protectionLoop", 0.1))
        end
    end)
end

local function startSelfCheck()
    spawn(function()
        local last = nil
        while active do
            perf:track("selfDamageCheck")
            local h = gHum(LPL.Character)
            if h then
                local cur = h.Health
                if last and cur < last then
                    if not selfDmgActive then selfDmgStart = tick() end
                    selfDmgActive = true
                    selfDmgTimer = 0
                    removeBillboard()
                else
                    if selfDmgActive then selfDmgDur = tick() - selfDmgStart end
                end
                last = cur
            end
            if selfDmgActive then
                selfDmgTimer = selfDmgTimer + 0.5
                if selfDmgTimer >= cfg.SelfDamageCooldown then
                    selfDmgActive = false
                    selfDmgDur = 0
                    if target and alive(target) then createBillboard(target) end
                end
            end
            task.wait(perf:getWait("selfDamageCheck", 0.1))
        end
    end)
end

-- 更新主账号状态信息
local function updateMainInfo()
    if not infoTxt then return end
    if MAIN == "" then
        infoTxt.Text = "状态信息\n主账号未设置"
        return
    end
    local m = getMain()
    if not m then
        infoTxt.Text = "主账号: " .. MAIN .. "\n状态: 离线或不存在"
        return
    end
    if not m.Character then
        infoTxt.Text = "主账号: " .. MAIN .. "\n状态: 在线但未生成角色"
        return
    end
    local hum = gHum(m.Character)
    if not hum then
        infoTxt.Text = "主账号: " .. MAIN .. "\n状态: 角色无 Humanoid"
        return
    end

    local hp = hum.Health
    local maxHp = hum.MaxHealth
    local d = distToMain()
    local isAlive = alive(m)
    local dmg, dmgAmt = takingDmg(m)
    local revenge = revengeTarget and "是 (" .. revengeTarget .. ")" or "否"
    local mode = isBot and "保护模式" or "普通模式"
    local myDmg = selfDmgActive and "受击中" or "正常"

    infoTxt.Text = string.format(
        "主账号: %s\n血量: %.0f/%.0f\n距离: %.1f\n在线: %s\n受击: %s (%.1f)\n复仇目标: %s\n模式: %s\n自身: %s",
        MAIN, hp, maxHp, d,
        isAlive and "是" or "否",
        dmg and "是" or "否", dmgAmt,
        revenge, mode, myDmg
    )
end

