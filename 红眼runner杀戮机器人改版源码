-- 辅助函数
local function gRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")) end
local function gHum(c) return c and (c:FindFirstChild("Humanoid") or c:FindFirstChildWhichIsA("Humanoid")) end
local function gAnim(c) local h = gHum(c) return h and h:FindFirstChildOfClass("Animator") end
local function gVel(c) local r = gRoot(c) return r and r.Velocity or Vector3.new() end

local blockedLook = {}
for id, _ in pairs(BLOCKED) do blockedLook[id] = true end
local allowedLook = {}
for id, _ in pairs(ALLOWED) do allowedLook[id] = true end

local function normId(id)
    if not id then return nil end
    local n = id:match("(%d+)$")
    return n and ("rbxassetid://" .. n) or id
end

local function getAnimIds(p)
    if not p or not p.Character then return {} end
    local a = gAnim(p.Character)
    if not a then return {} end
    local ids = {}
    for _, t in ipairs(a:GetPlayingAnimationTracks()) do
        if t.Animation and t.Animation.AnimationId then
            local n = normId(t.Animation.AnimationId)
            if n then table.insert(ids, n) end
        end
    end
    return ids
end

local function hasBlocked(p)
    if not p or not p.Character then return false end
    if p == LPL then
        local now = tick()
        if now - myAnimCheck < 0.1 then return myBlockedCache end
        myAnimCheck = now
    end
    local a = gAnim(p.Character)
    if not a then
        if p == LPL then myBlockedCache = false end
        return false
    end
    for _, id in ipairs(getAnimIds(p)) do
        if blockedLook[id] and not allowedLook[id] then
            if p == LPL then myBlockedCache = true end
            return true
        end
    end
    if p == LPL then myBlockedCache = false end
    return false
end

local function takingDmg(p)
    if not p or not p.Character then return false, 0 end
    local h = gHum(p.Character)
    if not h then return false, 0 end
    local cur = h.Health
    local last = healthHist[p]
    if last and cur < last then
        healthHist[p] = cur
        return true, last - cur
    end
    healthHist[p] = cur
    return false, 0
end

local function isAttacked(p)
    if not p then return false end
    if hasBlocked(LPL) then return false end
    return takingDmg(p) or hasBlocked(p)
end

local function alive(p) if not p or not p.Character then return false end local h = gHum(p.Character) return h and h.Health > 0 and h.Parent ~= nil end
local function dist(p) local r1 = gRoot(LPL.Character) local r2 = gRoot(p.Character) return r1 and r2 and (r1.Position - r2.Position).Magnitude or 9999 end
local function distPos(p1, p2) return (p1 - p2).Magnitude end

local function falling()
    local r = gRoot(LPL.Character)
    if not r then return false, nil end
    local p = r.Position
    local ray = Ray.new(p + Vector3.new(0, 2, 0), Vector3.new(0, -cfg.GroundCheckDistance, 0))
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LPL.Character})
    if not hit then
        local upRay = Ray.new(p, Vector3.new(0, cfg.GroundCheckDistance, 0))
        local upHit, upPos = workspace:FindPartOnRayWithIgnoreList(upRay, {LPL.Character})
        if upHit then
            local d = p.Y - upPos.Y
            if d > cfg.FallRescueThreshold then return true, upPos.Y + 3 end
        end
        return true, p.Y + 10
    end
    return false, nil
end

local function isMain(p) return p and MAIN ~= "" and p.Name == MAIN end
local function getMain() if MAIN == "" then return nil end if not mainP then mainP = game.Players:FindFirstChild(MAIN) end return mainP end
local function botAttacking() return hasBlocked(LPL) end

local function behindPos(c, d)
    if not c then return nil end
    local r = gRoot(c)
    if not r then return nil end
    local p = r.Position
    local v = gVel(c)
    local look = r.CFrame.LookVector
    local right = r.CFrame.RightVector
    local spd = v.Magnitude
    local side = -2.5
    if spd > 5 then
        local lead = math.min(spd * 0.4, 12)
        local pred = p + v.Unit * lead
        local perp = Vector3.new(-v.Unit.Z, 0, v.Unit.X).Unit
        if perp.Magnitude < 0.1 then perp = right end
        return pred + (perp * side)
    elseif spd > 1 then
        local lead = math.min(spd * 0.3, 8)
        local pred = p + v.Unit * lead
        local perp = Vector3.new(-v.Unit.Z, 0, v.Unit.X).Unit
        if perp.Magnitude < 0.1 then perp = right end
        return pred + (perp * side)
    else
        return p - (look * d) + (right * side)
    end
end

local function targetFree(p)
    if not p then return true end
    local owner = _G.BotTargets[p.Name]
    local ts = _G.TargetTimestamp[p.Name] or 0
    if not owner then return true end
    if owner == LPL.Name then _G.TargetTimestamp[p.Name] = tick(); return true end
    local ownerP = game.Players:FindFirstChild(owner)
    if not ownerP or not alive(ownerP) then _G.BotTargets[p.Name] = nil; return true end
    if tick() - ts > 2 then _G.BotTargets[p.Name] = nil; return true end
    return false
end

local function claim(p)
    if not p then return false end
    if not targetFree(p) then return false end
    _G.BotTargets[p.Name] = LPL.Name
    _G.TargetTimestamp[p.Name] = tick()
    return true
end
local function release(p)
    if not p then return end
    if _G.BotTargets[p.Name] == LPL.Name then _G.BotTargets[p.Name] = nil end
end

local function setRevenge(p)
    if not p then revengeTarget = nil; _G.RevengeTargets[LPL.Name] = nil; return end
    revengeTarget = p.Name
    _G.RevengeTargets[LPL.Name] = p.Name
end
local function getRevenge()
    if not revengeTarget then return nil end
    local p = game.Players:FindFirstChild(revengeTarget)
    if p and alive(p) and not isMain(p) then return p end
    if p then setRevenge(nil) end
    return nil
end

local function distToMain() local m = getMain() if not m or not m.Character then return 9999 end return dist(m) end

local function mainTakingDmg()
    local m = getMain()
    if not m or not m.Character then return false, 0 end
    local h = gHum(m.Character)
    if not h then return false, 0 end
    local cur = h.Health
    local last = lastMainHealth[m]
    if last and cur < last then
        local dmg = last - cur
        lastMainHealth[m] = cur
        lastMainDmg = tick()
        return true, dmg
    end
    lastMainHealth[m] = cur
    return false, 0
end

local function resetMainAttack()
    mainAttacking = false
end

local function checkMainAttack()
    local m = getMain()
    if not m or not m.Character then return false end
    if not botAttacking() then return false end
    local dmg, dmgAmt = mainTakingDmg()
    if not dmg or dmgAmt < 5 then return false end
    local mRoot = gRoot(m.Character)
    local myRoot = gRoot(LPL.Character)
    if not mRoot or not myRoot then return false end
    local myDist = distPos(myRoot.Position, mRoot.Position)
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= m and alive(p) and hasBlocked(p) then
            local pRoot = gRoot(p.Character)
            if pRoot and distPos(pRoot.Position, mRoot.Position) < myDist then return false end
        end
    end
    return true
end

local function findMainKiller(pos)
    if not pos then return nil end
    local closest, closestDist = nil, 9999
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LPL and not isMain(p) and alive(p) then
            if hasBlocked(p) then
                local r = gRoot(p.Character)
                if r then
                    local d = distPos(r.Position, pos)
                    if d < closestDist then closestDist = d; closest = p end
                end
            end
        end
    end
    if not closest then
        closestDist = 9999
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= LPL and not isMain(p) and alive(p) then
                local r = gRoot(p.Character)
                if r then
                    local d = distPos(r.Position, pos)
                    if d < closestDist then closestDist = d; closest = p end
                end
            end
        end
    end
    return closest
end

local function checkLongDmg() return selfDmgActive and (tick() - selfDmgStart) >= 2 end

local function findClosestEnemyToMain()
    local m = getMain()
    if not m or not m.Character then return nil end
    local mRoot = gRoot(m.Character)
    if not mRoot then return nil end
    local candidates = {}
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LPL and not isMain(p) and alive(p) then
            local r = gRoot(p.Character)
            if r then
                local d = distPos(r.Position, mRoot.Position)
                if d <= 40 then table.insert(candidates, {p = p, d = d, inCombat = isAttacked(p)}) end
            end
        end
    end
    table.sort(candidates, function(a, b) return a.d < b.d end)
    for _, c in ipairs(candidates) do if not c.inCombat then return c.p end end
    return #candidates > 0 and candidates[1].p or nil
end

local function resetChar(reason)
    if followLoop then followLoop:Disconnect() followLoop = nil end
    if attackLoop then attackLoop:Disconnect() attackLoop = nil end
    dmgThread = nil
    if target then release(target) end
    if targetBillboard then targetBillboard:Destroy(); targetBillboard = nil end
    if target then healthHist[target] = nil end
    target = nil
    tData = nil
    selfDmgActive = false
    selfDmgTimer = 0
    selfDmgStart = 0
    selfDmgDur = 0
    resetMainAttack()
    if LPL.Character then
        local h = gHum(LPL.Character)
        if h then h.Health = 0 else pcall(function() LPL.Character:BreakJoints() end) end
    end
end

local function teleNearMain()
    local m = getMain()
    if not m or not m.Character then return false end
    local mRoot = gRoot(m.Character)
    if not mRoot then return false end
    local a = math.random() * 2 * math.pi
    local r = math.random(15, 25)
    local pos = mRoot.Position + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
    local ray = Ray.new(pos + Vector3.new(0, 10, 0), Vector3.new(0, -20, 0))
    local hit, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, {LPL.Character, m.Character})
    local groundY = hit and hitPos.Y or pos.Y
    local safe = Vector3.new(pos.X, groundY + 3, pos.Z)
    local myRoot = gRoot(LPL.Character)
    if myRoot then myRoot.CFrame = CFrame.new(safe) lastProtectionTeleport = tick() return true end
    return false
end

