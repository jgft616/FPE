            statusTxt.Text = "状态: 禁用"
            stop("已禁用")
            queued = nil
            resetMainAttack()
        end
    end)
    uis.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.R then
            active = false
            if toggleBtn then
                toggleBtn.Text = "启用"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
            end
            if statusTxt then statusTxt.Text = "状态: 禁用" end
            stop("手动停止")
            queued = nil
            resetMainAttack()
        end
    end)
    LPL.CharacterAdded:Connect(function()
        stop("死亡")
        selfDmgActive = false
        selfDmgTimer = 0
        selfDmgStart = 0
        selfDmgDur = 0
        healthHist = {}
        queued = nil
        mainDmgResponse = false
        resetMainAttack()
        local rev = getRevenge()
        if rev and active then
            task.wait(1.5)
            attack(rev)
        end
    end)
end

