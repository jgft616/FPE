spawn(function() while task.wait(0.1) do refreshPlayerESP() end end)

-- ==================== 怪物透视（事件监听，严格排除玩家） ====================
local monsterESPObjects = {}

-- 判断模型是否为玩家角色（确保不误标记）
local function isPlayerModel(model)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then
            return true
        end
    end
    return false
end

local function addMonsterESP(model)
    if monsterESPObjects[model] then return end
    if isPlayerModel(model) then return end  -- 关键：跳过玩家
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    if not head then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 0, 0); hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.5; hl.Adornee = model; hl.Parent = model
    local bill = Instance.new("BillboardGui")
    bill.AlwaysOnTop = true; bill.Size = UDim2.new(0, 100, 0, 30)
    bill.StudsOffset = Vector3.new(0, 2.5, 0); bill.Adornee = head; bill.Parent = head
    local txt = Instance.new("TextLabel", bill)
    txt.BackgroundTransparency = 1; txt.Text = model.Name .. " [怪物]"
    txt.TextColor3 = Color3.new(1, 1, 1); txt.Font = Enum.Font.SourceSansBold; txt.TextSize = 14
    monsterESPObjects[model] = { Highlight = hl, Billboard = bill }
end

local function removeMonsterESP(model)
    local data = monsterESPObjects[model]
    if data then
        pcall(function() data.Highlight:Destroy() end)
        pcall(function() data.Billboard:Destroy() end)
        monsterESPObjects[model] = nil
    end
end

local function onDescendantAdded(descendant)
    if not MonsterESPEnabled then return end
    if descendant:IsA("Model") and descendant:FindFirstChildWhichIsA("Humanoid") then
        addMonsterESP(descendant)
    end
end

local function onDescendantRemoving(descendant)
    if descendant:IsA("Model") then removeMonsterESP(descendant) end
end

local function toggleMonsterESP(on)
    MonsterESPEnabled = on
    if on then
        -- 扫描现有怪物，并排除玩家
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildWhichIsA("Humanoid") and not isPlayerModel(obj) then
                addMonsterESP(obj)
            end
        end
        workspace.DescendantAdded:Connect(onDescendantAdded)
        workspace.DescendantRemoving:Connect(onDescendantRemoving)
        notify("怪物透视", "✅ 已开启")
    else
        for model, _ in pairs(monsterESPObjects) do removeMonsterESP(model) end
        notify("怪物透视", "已关闭")
    end
end

-- ==================== 夜视 ====================
local function toggleNightVision(on)
    NightVisionEnabled = on
    if on then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255); Lighting.Brightness = 3
        notify("夜视", "✅ 已开启")
    else
        Lighting.Ambient = Color3.fromRGB(0, 0, 0); Lighting.Brightness = 1
        notify("夜视", "已关闭")
    end
end
