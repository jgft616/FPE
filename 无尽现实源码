-- ==================== 穿墙 ====================
local function setCollisions(parts, state)
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            pcall(function() part.CanCollide = state end)
        end
    end
end

local function noclipStep()
    if not NoclipEnabled then return end
    local char = LP.Character
    if char then
        setCollisions(char:GetDescendants(), false)
        setCollisions({char}, false)
    end
end

local function toggleNoclip(on)
    NoclipEnabled = on
    if on then
        noclipLoop = RunService.Stepped:Connect(noclipStep)
        notify("穿墙", "✅ 已开启")
    else
        if noclipLoop then noclipLoop:Disconnect(); noclipLoop = nil end
        local char = LP.Character
        if char then
            setCollisions(char:GetDescendants(), true)
            setCollisions({char}, true)
        end
        notify("穿墙", "已关闭")
    end
end

