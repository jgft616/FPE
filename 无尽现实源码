local SpeedValue = 16
local speedLoop = nil

-- ==================== 防挂机（后台自动运行） ====================
spawn(function()
    while task.wait(5) do
        pcall(function()
            local char = LP.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.MoveDirection.Magnitude == 0 then
                    hum:Move(Vector3.new(0.01, 0, 0))
                    task.wait(0.01)
                    hum:Move(Vector3.new(0, 0, 0))
                end
            end
        end)
    end
end)

-- ==================== 移动速度 ====================
local function applySpeed(value)
    SpeedValue = value
    if SpeedEnabled then
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = value end
        end
    end
end

local function toggleSpeed(on)
    SpeedEnabled = on
    if on then
        applySpeed(SpeedValue)
        speedLoop = RunService.Heartbeat:Connect(function()
            if not SpeedEnabled then return end
            local char = LP.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = SpeedValue end
            end
        end)
        notify("移动速度", "✅ 已开启 (" .. SpeedValue .. ")")
    else
        if speedLoop then speedLoop:Disconnect(); speedLoop = nil end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
        end
        notify("移动速度", "已关闭")
    end
end

-- ==================== 玩家透视（全绿，无队伍检测，0.1秒刷新） ====================
local playerESPObjects = {}

local function clearPlayerESP()
    for _, data in pairs(playerESPObjects) do
        pcall(function() data.Highlight:Destroy() end)
        pcall(function() data.Billboard:Destroy() end)
    end
    playerESPObjects = {}
end

local function refreshPlayerESP()
    if not PlayerESPEnabled then return end
    for player, data in pairs(playerESPObjects) do
        if not player.Parent or not player.Character then
            pcall(function() data.Highlight:Destroy() end)
            pcall(function() data.Billboard:Destroy() end)
            playerESPObjects[player] = nil
        elseif data.Highlight.Adornee ~= player.Character then
            pcall(function() data.Highlight:Destroy() end)
            pcall(function() data.Billboard:Destroy() end)
            playerESPObjects[player] = nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local char = player.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        if not head then continue end
        if not playerESPObjects[player] then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(0, 255, 0)
            hl.OutlineColor = Color3.new(1, 1, 1)
            hl.FillTransparency = 0.5
            hl.Adornee = char
            hl.Parent = char
            local bill = Instance.new("BillboardGui")
            bill.AlwaysOnTop = true; bill.Size = UDim2.new(0, 100, 0, 30)
            bill.StudsOffset = Vector3.new(0, 2.5, 0); bill.Adornee = head; bill.Parent = head
            local txt = Instance.new("TextLabel", bill)
            txt.BackgroundTransparency = 1; txt.Text = player.Name .. " [玩家]"
            txt.TextColor3 = Color3.new(1, 1, 1); txt.Font = Enum.Font.SourceSansBold; txt.TextSize = 14
            playerESPObjects[player] = { Highlight = hl, Billboard = bill }
        end
    end
end

local function togglePlayerESP(on)
    PlayerESPEnabled = on
    if on then refreshPlayerESP(); notify("玩家透视", "✅ 已开启（全绿）")
    else clearPlayerESP(); notify("玩家透视", "已关闭") end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LP then player.CharacterAdded:Connect(function() task.wait(0.1); refreshPlayerESP() end) end
end
Players.PlayerAdded:Connect(function(player) player.CharacterAdded:Connect(function() task.wait(0.1); refreshPlayerESP() end) end)
