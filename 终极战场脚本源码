-- 碰撞箱
local hitboxOrigBox
local function toggleHitbox(on)
    hitboxCfg.Enabled=on; local hit = Core.Get("Combat","Hit")
    if on then
        if not hitboxOrigBox then hitboxOrigBox=hit.Box end
        hit.Box = function(_,char,data) data=data or{}; data.Size=Vector3.new(hitboxCfg.X,hitboxCfg.Y,hitboxCfg.Z); return hitboxOrigBox(nil,char,data) end
    else
        if hitboxOrigBox then hit.Box=hitboxOrigBox end
    end
end

-- 锁人
local function lockUpdate()
    if lockTarget=="" then return end
    local target; for _,p in ipairs(Players:GetPlayers()) do if p.Name==lockTarget then target=p break end end
    if not target or not target.Character then return end
    local tRoot=target.Character:FindFirstChild("HumanoidRootPart"); local mRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot or not mRoot then return end
    local targetPos=tRoot.Position; local finalPos=nil
    if lockCircle then local a=tick()*13; finalPos=targetPos+Vector3.new(math.cos(a)*6,0,math.sin(a)*6)
    elseif lockBehind then finalPos=targetPos-tRoot.CFrame.LookVector*5 end
    if finalPos then
        if lockLook then mRoot.CFrame=CFrame.new(finalPos,Vector3.new(targetPos.X,finalPos.Y,targetPos.Z))
        else mRoot.CFrame=CFrame.new(finalPos)*mRoot.CFrame.Rotation end
    elseif lockLook then mRoot.CFrame=CFrame.new(mRoot.Position,Vector3.new(targetPos.X,mRoot.Position.Y,targetPos.Z)) end
end

