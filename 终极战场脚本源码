-- 范围显示
local rangeDisplayActive = false
local rangeDisplayParts = {}
local rangeDisplayConn
addToggle(mainTab, "范围显示", false, function(state)
    rangeDisplayActive = state
    if rangeDisplayConn then rangeDisplayConn:Disconnect(); rangeDisplayConn = nil end
    if state then
        local radius = 60
        local segments = 60
        for i = 1, segments do
            local part = Instance.new("Part")
            part.Anchored = true
            part.CanCollide = false
            part.Material = Enum.Material.Neon
            part.Size = Vector3.new(0.2, 0.2, radius * 2 * math.pi / segments)
            part.Color = Color3.fromRGB(180,180,180)
            part.Parent = workspace
            table.insert(rangeDisplayParts, part)
        end
        local time = 0
        rangeDisplayConn = RunService.RenderStepped:Connect(function(dt)
            time += dt
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local pos = char.HumanoidRootPart.Position - Vector3.new(0,3,0)
                for i, part in ipairs(rangeDisplayParts) do
                    local angle = (i / #rangeDisplayParts) * 2 * math.pi
                    part.Position = Vector3.new(pos.X + math.cos(angle) * radius, pos.Y, pos.Z + math.sin(angle) * radius)
                    part.Orientation = Vector3.new(0, -math.deg(angle), 0)
                    part.Color = Color3.fromRGB(
                        math.sin(time) * 40 + 180,
                        math.sin(time + 2) * 40 + 180,
                        math.sin(time + 4) * 40 + 180
                    )
                end
            end
        end)
    else
        for _, part in ipairs(rangeDisplayParts) do part:Destroy() end
        rangeDisplayParts = {}
    end
end)

