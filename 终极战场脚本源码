    DashT = 0
}

addToggle(hitboxTab, "碰撞箱扩大", false, function(state)
    hitbox.Enabled = state
    local rs = game:GetService("ReplicatedStorage")
    local core = require(rs:WaitForChild("Core"))
    local hit = core.Get("Combat", "Hit")
    if state then
        if not hitbox.Cache.OrigBox then
            hitbox.Cache.OrigBox = hit.Box
        end
        hit.Box = function(_, char, data)
            data = data or {}
            data.Size = Vector3.new(hitbox.X, hitbox.Y, hitbox.Z)
            return hitbox.Cache.OrigBox(nil, char, data)
        end
        local ok, hitModule = pcall(function()
            return require(LP.PlayerScripts:WaitForChild("Combat"):WaitForChild("Hit"))
        end)
        if ok and hitModule.Process then
            hitbox.Cache.HitProc = hitModule.Process
            hitModule.Process = function(...)
                local best, targets, blocked = hitbox.Cache.HitProc(...)
                if targets and #targets > 0 then
                    local r = rs.Remotes.Combat.Action
                    for _ = 1, 3 do
                        pcall(function()
                            r:FireServer(nil, "", 4, 69, {BestHitCharacter=nil, HitCharacters=targets, Ignore={}, Actions={}})
                        end)
                    end
                end
                return best, targets, blocked
            end
        end
    else
        if hitbox.Cache.OrigBox then
            hit.Box = hitbox.Cache.OrigBox
            hitbox.Cache.OrigBox = nil
        end
        if hitbox.Cache.HitProc then
            local ok, hitModule = pcall(function()
                return require(LP.PlayerScripts.Combat.Hit)
            end)
            if ok then hitModule.Process = hitbox.Cache.HitProc end
            hitbox.Cache.HitProc = nil
        end
    end
end)

