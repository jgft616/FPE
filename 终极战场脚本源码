local function addToggle(text, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -10, 0, 18)
    f.BackgroundTransparency = 1
    f.Parent = Scroll

    local label = Instance.new("TextLabel", f)
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextColor3 = Color3.fromRGB(255, 255, 255)

    local btn = Instance.new("TextButton", f)
    btn.Size = UDim2.new(0, 44, 1, -2)
    btn.Position = UDim2.new(0.7, 0, 0, 1)
    btn.BackgroundColor3 = default and Color3.fromRGB(0,170,0) or Color3.fromRGB(170,0,0)
    btn.Text = default and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0

    local on = default
    btn.MouseButton1Click:Connect(function()
        on = not on
        btn.BackgroundColor3 = on and Color3.fromRGB(0,170,0) or Color3.fromRGB(170,0,0)
        btn.Text = on and "ON" or "OFF"
        callback(on)
    end)
end

local function addSlider(text, min, max, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -10, 0, 28)
    f.BackgroundTransparency = 1
    f.Parent = Scroll

    local label = Instance.new("TextLabel", f)
    label.Size = UDim2.new(1, 0, 0, 10)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. default
    label.Font = Enum.Font.Gotham
    label.TextSize = 9
    label.TextColor3 = Color3.fromRGB(255, 255, 255)

    local s = Instance.new("Frame", f)
    s.Size = UDim2.new(1, 0, 0, 6)
    s.Position = UDim2.new(0, 0, 0, 11)
    s.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    s.BorderSizePixel = 0

    local fill = Instance.new("Frame", s)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
    fill.BorderSizePixel = 0

    local dragging = false
    s.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local pos = i.Position.X - s.AbsolutePosition.X
            local ratio = math.clamp(pos / s.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ratio * (max - min) + 0.5)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            label.Text = text .. ": " .. val
            callback(val)
        end
    end)
end

local function addInput(placeholder, default, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -10, 0, 16)
    box.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    box.Text = default
    box.Font = Enum.Font.Gotham
    box.TextSize = 9
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.PlaceholderText = placeholder
    box.BorderSizePixel = 0
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    box.Parent = Scroll
    box.FocusLost:Connect(function() callback(box.Text) end)
end

local function addButton(text, callback)
