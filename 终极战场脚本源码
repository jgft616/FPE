local function updateLockLoop()
    if lockData.Conn then lockData.Conn:Disconnect(); lockData.Conn = nil end
    if lockData.Follow or lockData.Circle or lockData.Look then
        lockData.Conn = RunService.RenderStepped:Connect(function(dt)
            if not lockData.Selected then return end
            local target = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name == lockData.Selected then target = p break end
            end
            if not target or not target.Character then return end
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot or not myRoot then return end
            if lockData.Circle then
                lockData.Angle += 13 * dt
                local x = math.cos(lockData.Angle) * 6
                local z = math.sin(lockData.Angle) * 6
                myRoot.CFrame = CFrame.new(targetRoot.Position + Vector3.new(x,0,z)) * myRoot.CFrame.Rotation
            elseif lockData.Follow then
                myRoot.CFrame = CFrame.new(targetRoot.Position - targetRoot.CFrame.LookVector * 5) * myRoot.CFrame.Rotation
            elseif lockData.Look then
                myRoot.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
            end
        end)
    end
end

addToggle(lockTab, "锁背", false, function(state)
    lockData.Follow = state
    if state then lockData.Circle = false end
    updateLockLoop()
end)

addToggle(lockTab, "转圈", false, function(state)
    lockData.Circle = state
    if state then lockData.Follow = false end
    updateLockLoop()
end)

addToggle(lockTab, "看着玩家", false, function(state)
    lockData.Look = state
    updateLockLoop()
end)

