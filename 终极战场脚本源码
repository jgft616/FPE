-- 悬浮球拖动限制
local dotDragging, dotStart, dotStartPos
local screenSize = workspace.CurrentCamera.ViewportSize
ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dotDragging = true; dotStart = input.Position; dotStartPos = ToggleBtn.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dotDragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dotDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dotStart
        local newX = math.clamp(dotStartPos.X.Offset + delta.X, 0, screenSize.X - ToggleBtn.AbsoluteSize.X)
        local newY = math.clamp(dotStartPos.Y.Offset + delta.Y, 0, screenSize.Y - ToggleBtn.AbsoluteSize.Y)
        ToggleBtn.Position = UDim2.new(0, newX, 0, newY)
    end
end)

