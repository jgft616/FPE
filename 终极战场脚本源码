    if gameProcessed then return end
    if input.KeyCode == emoteData.Keybind and emoteData.Selected then
        useEmote(emoteData.Selected)
    end
end)

addButton(emoteTab, "随机用一个击杀表情", function()
    if #emoteData.List > 0 then
        useEmote(emoteData.List[math.random(#emoteData.List)])
    end
end)

