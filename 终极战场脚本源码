-- 标签页存储
local tabs = {}

local function createTab(title)
    local index = #tabs + 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 1, -6)
    btn.Position = UDim2.new(0, 5 + (index-1)*85, 0, 3)
    btn.Text = title
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = (index == 1) and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(50, 50, 60)
    btn.AutoButtonColor = false
    btn.Parent = tabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 6
    scroll.ScrollBarImageColor3 = Color3.fromRGB(255, 105, 180)
    scroll.BorderSizePixel = 0
    scroll.Visible = (index == 1)
    scroll.Parent = contentArea

    local inner = Instance.new("Frame")
    inner.Size = UDim2.new(1, 0, 0, 10)
    inner.BackgroundTransparency = 1
    inner.Parent = scroll

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = inner

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
        inner.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    local tabData = { Button = btn, Scroll = scroll, Inner = inner, Layout = layout }
    tabs[index] = tabData

    btn.MouseButton1Click:Connect(function()
        for i, t in ipairs(tabs) do
            t.Scroll.Visible = (i == index)
            t.Button.BackgroundColor3 = (i == index) and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(50, 50, 60)
        end
    end)

    return tabData
end

-- UI 组件函数
local function addButton(tab, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 26)
    btn.Position = UDim2.new(0, 4, 0, 0)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(255, 105, 180)
    btn.AutoButtonColor = false
    btn.Parent = tab.Inner
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function addToggle(tab, text, initial, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 22)
    frame.BackgroundTransparency = 1
    frame.Parent = tab.Inner

    local label = Instance.new("TextLabel")
    label.Text = text
    label.Font = Enum.Font.Gotham
    label.TextSize = 11
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0, 200, 1, 0)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 36, 0, 18)
    switch.Position = UDim2.new(1, -40, 0.5, -9)
    switch.BackgroundColor3 = initial and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(80, 80, 80)
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = initial and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = initial
    switch.MouseButton1Click:Connect(function()
        state = not state
        switch.BackgroundColor3 = state and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(80, 80, 80)
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        callback(state)
    end)

    return frame
end

local function addInput(tab, text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 36)
    frame.BackgroundTransparency = 1
    frame.Parent = tab.Inner

    local label = Instance.new("TextLabel")
    label.Text = text
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextColor3 = Color3.fromRGB(180, 180, 200)
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 14)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -8, 0, 20)
    input.Position = UDim2.new(0, 4, 0, 16)
    input.Text = tostring(default or "")
    input.Font = Enum.Font.Gotham
    input.TextSize = 11
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    input.Parent = frame
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 4)

    input.FocusLost:Connect(function(enter)
        if enter then callback(input.Text) end
    end)
    return frame
end

local function addSlider(tab, text, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -8, 0, 36)
    frame.BackgroundTransparency = 1
    frame.Parent = tab.Inner

    local label = Instance.new("TextLabel")
    label.Text = text .. ": " .. default
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextColor3 = Color3.fromRGB(180, 180, 200)
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 14)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, -8, 0, 20)
    input.Position = UDim2.new(0, 4, 0, 16)
    input.Text = tostring(default)
    input.Font = Enum.Font.Gotham
    input.TextSize = 11
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    input.Parent = frame
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 4)

    input.FocusLost:Connect(function(enter)
        if enter then
            local val = tonumber(input.Text)
            if val then
                val = math.clamp(val, min, max)
                label.Text = text .. ": " .. val
                callback(val)
            end
        end
    end)
    return frame
end

