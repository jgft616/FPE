            if tool then
                pcall(function()
                    tool:SetAttribute("HitboxSize", Vector3.new(BatRangeValue, BatRangeValue, BatRangeValue))
                end)
                local hitboxVal = tool:FindFirstChild("HitboxSize")
                if hitboxVal and hitboxVal:IsA("Vector3Value") then
                    hitboxVal.Value = Vector3.new(BatRangeValue, BatRangeValue, BatRangeValue)
                end
