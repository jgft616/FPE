-- ========== 透视系统 ==========
local espObjects = {}

local function clearESP()
    for _, data in pairs(espObjects) do
        pcall(function() data.Highlight:Destroy() end)
        pcall(function() data.Billboard:Destroy() end)
    end
    espObjects = {}
end

local function refreshESP()
    if not ESPEnabled then return end
    for player, data in pairs(espObjects) do
        local hl = data.Highlight
        local char = player.Character
        if not player.Parent or not char then
            pcall(function() hl:Destroy() end)
            pcall(function() data.Billboard:Destroy() end)
            espObjects[player] = nil
        elseif hl and (not hl.Adornee or hl.Adornee ~= char) then
            pcall(function() hl:Destroy() end)
            pcall(function() data.Billboard:Destroy() end)
            espObjects[player] = nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local char = player.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        if not head then continue end
        local isFriend = IsTeammate(player)
        local color = isFriend and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        local label = player.Name .. (isFriend and " [队友]" or " [敌人]")
        if not espObjects[player] then
            local hl = Instance.new("Highlight")
            hl.FillColor = color; hl.OutlineColor = Color3.new(1,1,1)
            hl.FillTransparency = 0.5; hl.Adornee = char; hl.Parent = char
            local bill = Instance.new("BillboardGui")
            bill.AlwaysOnTop = true; bill.Size = UDim2.new(0,100,0,30)
            bill.StudsOffset = Vector3.new(0,2.5,0); bill.Adornee = head; bill.Parent = head
            local txt = Instance.new("TextLabel", bill)
            txt.BackgroundTransparency = 1; txt.Text = label; txt.TextColor3 = Color3.new(1,1,1)
            txt.Font = Enum.Font.SourceSansBold; txt.TextSize = 14
            espObjects[player] = { Highlight = hl, Billboard = bill }
        else
            espObjects[player].Highlight.FillColor = color
            local bill = espObjects[player].Billboard
            if bill and bill:FindFirstChild("TextLabel") then
                bill.TextLabel.Text = label
            end
        end
    end
end

spawn(function()
    while task.wait(0.1) do
        pcall(refreshESP)
    end
end)

