-- ========== 防拉回 ==========
local PULLBACK_THRESHOLD = 150
spawn(function()
    local lastPosition = nil
    while task.wait(0.1) do
        pcall(function()
            local char = LP.Character
            if not char then lastPosition = nil; return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then lastPosition = nil; return end
            local currentPos = hrp.Position
            if lastPosition then
                local displacement = (currentPos - lastPosition).Magnitude
                if displacement > PULLBACK_THRESHOLD then
                    local pushDir = (lastPosition - currentPos).Unit
                    hrp.Velocity = pushDir * displacement * 3
                end
            end
            lastPosition = hrp.Position
        end)
    end
end)

-- ========== 球棒攻击范围 ==========
