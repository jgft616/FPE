-- 拖动系统
local dragging, dragStart, startPos
tb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = main.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local dotDragging, dotStart, dotStartPos
local screenSize = workspace.CurrentCamera.ViewportSize
miniDot.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dotDragging = true; dotStart = input.Position; dotStartPos = miniDot.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dotDragging = false end end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dotDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dotStart
        local newX = dotStartPos.X.Offset + delta.X
        local newY = dotStartPos.Y.Offset + delta.Y
        newX = math.clamp(newX, 0, screenSize.X - miniDot.AbsoluteSize.X)
        newY = math.clamp(newY, 0, screenSize.Y - miniDot.AbsoluteSize.Y)
        miniDot.Position = UDim2.new(0, newX, 0, newY)
    end
end)

