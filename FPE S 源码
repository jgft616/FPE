-- ========== 队伍检测 ==========
local function IsTeammate(player)
    if player == LP then return true end
    if not TeamCheckEnabled then return false end
    if LP.Team and player.Team then return LP.Team == player.Team end
    local char = player.Character
    if char then
        local students = workspace:FindFirstChild("Students")
        local teachers = workspace:FindFirstChild("Teachers")
        local myChar = LP.Character
        if students and teachers and myChar then
            if char:IsDescendantOf(students) and myChar:IsDescendantOf(students) then return true end
            if char:IsDescendantOf(teachers) and myChar:IsDescendantOf(teachers) then return true end
        end
    end
    return false
end

