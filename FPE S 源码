-- 清除所有特效（不影响透视/队伍检测）
local function removeAllEffects()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") then
            pcall(function() obj:Destroy() end)
        end
    end
end

local function toggleClearEffects(on)
    ClearEffectsEnabled = on
    if on then
        removeAllEffects()
        if clearEffectsConn then clearEffectsConn:Disconnect() end
        clearEffectsConn = Lighting.ChildAdded:Connect(function(child)
            if child:IsA("PostEffect") then
                pcall(function() child:Destroy() end)
            end
        end)
        notify("清除特效", "✅ 所有后期特效已清除（可能不全但能看见）")
    else
        if clearEffectsConn then clearEffectsConn:Disconnect() end
        notify("清除特效", "已关闭")
    end
end

-- ==================== 门/皮肤商店删除 ====================
local function deleteElectricRoomDoor()
    local doors = workspace:FindFirstChild("Area")
    if doors then doors = doors:FindFirstChild("Map") end
    if doors then doors = doors:FindFirstChild("Doors") end
    if not doors then
        notify("删除失败", "未找到 Doors")
        return
    end
    local deletedCount = 0
    local children = doors:GetChildren()
    for _, child in ipairs(children) do
        local mesh = child:FindFirstChild("Mesh")
        if mesh then
            pcall(function() child:Destroy() end)
            deletedCount = deletedCount + 1
        end
    end
    if deletedCount > 0 then
        notify("电立室门删除", "所有电力室门已删除")
    else
        notify("电立室门删除", "未找到包含 Mesh 的门")
    end
end

local function deleteSkinShop()
    local map = workspace:FindFirstChild("Area")
    if map then map = map:FindFirstChild("Map") end
    if not map then
        notify("皮肤商店删除", "未找到 Area/Map")
        return
    end

    local skinShop = map:FindFirstChild("SkinSelectionShop")
    if skinShop then
        local locker = skinShop:FindFirstChild("BaseLocker")
        if locker then pcall(function() locker:Destroy() end) end
        local shelf = skinShop:FindFirstChild("Shelf")
        if shelf then pcall(function() shelf:Destroy() end) end
    end

    local doors = map:FindFirstChild("Doors")
    if doors then
        local storageDoor = doors:FindFirstChild("StorageDoor")
        if storageDoor then
            local dd2 = storageDoor:FindFirstChild("DoubleDoor2")
            if dd2 then pcall(function() dd2:Destroy() end) end
            local dd = storageDoor:FindFirstChild("DoubleDoor")
            if dd then pcall(function() dd:Destroy() end) end
        end
    end

    local collisions = map:FindFirstChild("CollisionBoxes")
    if collisions then
        local col = collisions:FindFirstChild("StorageDoorCollision")
        if col then pcall(function() col:Destroy() end) end
    end

    notify("皮肤商店删除", "✅ 已删除所有皮肤商店相关对象（只有夜晚才有用）")
end

