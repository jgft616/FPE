-- ========== 门删除 ==========
local function deleteElectricRoomDoor()
    local doors = workspace:FindFirstChild("Area")
    if doors then doors = doors:FindFirstChild("Map") end
    if doors then doors = doors:FindFirstChild("Doors") end
    if not doors then notify("删除失败", "未找到 Doors"); return end
    local deletedCount = 0
    for _, child in ipairs(doors:GetChildren()) do
        if child:FindFirstChild("Mesh") then
            pcall(function() child:Destroy() end)
            deletedCount = deletedCount + 1
        end
    end
    notify("电立室门删除", deletedCount > 0 and "所有电力室门已删除" or "未找到包含 Mesh 的门")
end

local function deleteSkinShop()
    local map = workspace:FindFirstChild("Area")
    if map then map = map:FindFirstChild("Map") end
    if not map then notify("皮肤商店删除", "未找到 Area/Map"); return end
    local skinShop = map:FindFirstChild("SkinSelectionShop")
    if skinShop then
        pcall(function() skinShop:FindFirstChild("BaseLocker"):Destroy() end)
        pcall(function() skinShop:FindFirstChild("Shelf"):Destroy() end)
    end
    local doors = map:FindFirstChild("Doors")
    if doors then
        local storageDoor = doors:FindFirstChild("StorageDoor")
        if storageDoor then
            pcall(function() storageDoor:FindFirstChild("DoubleDoor2"):Destroy() end)
            pcall(function() storageDoor:FindFirstChild("DoubleDoor"):Destroy() end)
        end
    end
    local collisions = map:FindFirstChild("CollisionBoxes")
    if collisions then pcall(function() collisions:FindFirstChild("StorageDoorCollision"):Destroy() end) end
    notify("皮肤商店删除", "已删除所有皮肤商店相关对象")
end

