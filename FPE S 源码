-- ==================== 防拉回（阈值150） ====================
local PULLBACK_THRESHOLD = 150
spawn(function()
    local lastPosition = nil
    while task.wait(0.1) do
        pcall(function()
            local char = LP.Character
            if not char then lastPosition = nil; return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then lastPosition = nil; return end
            local currentPos = hrp.Position
            if lastPosition then
                local displacement = (currentPos - lastPosition).Magnitude
                if displacement > PULLBACK_THRESHOLD then
                    local pushDir = (lastPosition - currentPos).Unit
                    hrp.Velocity = pushDir * displacement * 3
                end
            end
            lastPosition = hrp.Position
        end)
    end
end)

-- ==================== 应用所有设置（关闭时不做任何修改） ====================
local function applyAllSettings()
    local char = LP.Character
    if char then
        if MaxStaminaEnabled then
            pcall(function() char:SetAttribute("MaxStamina", MaxStaminaValue) end)
        end
        if StaminaRecoveryEnabled then
            pcall(function() char:SetAttribute("Stamina", StaminaRecoveryValue) end)
        end
    end
    for attrName, enabled in pairs(PassesEnabled) do
        if enabled then pcall(function() LP:SetAttribute(attrName, true) end) end
    end
end

LP.CharacterAdded:Connect(function() task.wait(0.1); applyAllSettings() end)

spawn(function()
    while task.wait(0.5) do
        applyAllSettings()
    end
end)

-- ==================== 功能函数 ====================
local function toggleMaxStamina(on)
    MaxStaminaEnabled = on
    if not on then
        pcall(function()
            local char = LP.Character
            if char then char:SetAttribute("MaxStamina", 100) end
        end)
    end
    applyAllSettings()
    notify("最大体力", on and "✅ 已开启" or "已关闭")
end

local function setMaxStamina(val)
    local num = tonumber(val)
    if not num then return end
    MaxStaminaValue = num
    if MaxStaminaEnabled then applyAllSettings() end
end

local function toggleStaminaRecovery(on)
    StaminaRecoveryEnabled = on
    applyAllSettings()
    notify("体力恢复", on and "✅ 已开启" or "已关闭")
end

local function setStaminaRecovery(val)
    local num = tonumber(val)
    if not num then return end
    StaminaRecoveryValue = num
    if StaminaRecoveryEnabled then applyAllSettings() end
end

local function getPass(name, attrName)
    PassesEnabled[attrName] = true
    applyAllSettings()
    notify("通行证", "✅ 已获取: " .. name)
end

