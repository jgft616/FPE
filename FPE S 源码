local function applyAllSettings()
    local char = LP.Character
    if char then
        if MaxStaminaEnabled then pcall(function() char:SetAttribute("MaxStamina", MaxStaminaValue) end) end
        if StaminaRecoveryEnabled then pcall(function() char:SetAttribute("Stamina", StaminaRecoveryValue) end) end
    end
    for attrName, enabled in pairs(PassesEnabled) do
        if enabled then pcall(function() LP:SetAttribute(attrName, true) end) end
    end
end

