-- 安全输入
local function SafeUpdateAnswer(text)
    pcall(function()
        if ClickSound then ClickSound:Play() end
        TypingText.Text = text
        GameEvent:FireServer("updateAnswer", text)
    end)
end

-- 模拟打字
local function HumanType(target)
    local text = ""
    while text ~= target do
        if math.random() < BigErrorChance then
            local wrong = tostring(math.random(1, 200))
            SafeUpdateAnswer(wrong)
            task.wait(0.1 * (1 + math.random()))
            SafeUpdateAnswer(string.sub(wrong, 1, math.random(0, #wrong)))
            task.wait(0.1 * (1 + math.random()))
        end
        local nextLen = #text + 1
        text = string.sub(target, 1, nextLen)
        SafeUpdateAnswer(text)
        if math.random() < 0.2 then
            task.wait(TypingSpeed * (2 + math.random() * 2))
        else
            task.wait(TypingSpeed * (1 + math.random()))
        end
        if InstantSubmit and text == target then
            pcall(function() GameEvent:FireServer("submitAnswer", text) end)
            return
        end
    end
    if not InstantSubmit then
        pcall(function() GameEvent:FireServer("submitAnswer", target) end)
    end
end

-- 答案计算
local function ComputeAnswer(questionStr)
    local success, result = pcall(function()
        local expr = string.gsub(questionStr:match("^(.-)=") or "", "x", "*")
        if expr == "" then return nil end
        return tostring(loadstring("return " .. expr)())
    end)
    return success and result or nil
end

-- 主逻辑
local function OnNewQuestion()
    if not CustomEnabled then return end
    if CurrentSpeller.Value ~= Player then return end
    local question = QuestionText.Text
    if question == "" then return end
    local answer = ComputeAnswer(question)
    if not answer then return end
    pcall(function() Fill:SetAttribute("Answer", answer) end)
    SafeUpdateAnswer("")
    task.wait(CustomDelay)
    HumanType(answer)
end

