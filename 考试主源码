        hl.OutlineColor=Color3.fromRGB(255,255,255); hl.OutlineTransparency=1
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=btrModel
        local bb = Instance.new("BillboardGui")
