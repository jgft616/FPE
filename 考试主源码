    TabMagic:Button({ Title = "最大距离 50", Callback = function() mbWorldDistMax=50; cachedTarget=nil; lastFindTick=0 end })
    TabMagic:Button({ Title = "最大距离 200", Callback = function() mbWorldDistMax=200; cachedTarget=nil; lastFindTick=0 end })

    local AIM_LABELS = {"头部","躯干","左臂","右臂","左腿","右腿"}
    TabMagic:Dropdown({
        Title = "锁定部位",
        Values = AIM_LABELS,
