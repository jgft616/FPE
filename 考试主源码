-- ===== WindUI Toggle 工厂（替代原 toggleBase/toggleMagic/toggleRadar）=====
local function makeToggle(tab)
    return function(title, _keyIgnored, default, callback, _sizeIgnored)
        local state = default
        local obj = tab:Toggle({
            Title = title,
            Value = default,
            Callback = function(v) state = v; callback(v) end,
        })
        local function setState(v)
            if state == v then return end
            state = v
            local ok = pcall(function() obj:Set(v) end)
            if not ok then callback(v) end
        end
        return obj, setState
    end
end
local toggleBase  = makeToggle(TabBase)
local toggleMagic = makeToggle(TabMagic)
local toggleRadar = makeToggle(TabRadar)

