-- 模块 5.5: 自动获得孤装徽章
-- ============================================
do
    local BADGE_TARGET_POS = Vector3.new(261.07, -31.00, -1172.49)
    local TELEPORT_BACK_DELAY = 1.0
    local badgeRunning = false

    local function getMyRoot()
        local char = lp.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function doBadgeSequence()
        if badgeRunning then return end
        badgeRunning = true

        task.spawn(function()
            local root = getMyRoot()
            if not root then
                warn("[Badge] 角色未加载，跳过")
                badgeRunning = false
                return
            end

            -- 1. 保存当前位置
            local savedCFrame = root.CFrame

            -- 2. 传送到目标坐标
            local okTP = pcall(function()
                root.CFrame = CFrame.new(BADGE_TARGET_POS)
            end)
            if not okTP then
                warn("[Badge] 传送到目标点失败")
                badgeRunning = false
                return
            end
            print("[Badge] 已传送到孤装徽章点")

            -- 3. 等待 1 秒
            task.wait(TELEPORT_BACK_DELAY)

            -- 4. 传送回原位置
            local root2 = getMyRoot()
