-- ========== 队伍检测函数 ==========
local function IsTeammate(player)
    if player == LP then return true end
    if not TeamCheckEnabled then return false end
    if LP.Team and player.Team then return LP.Team == player.Team end
    local char = player.Character
    if char then
        local students = workspace:FindFirstChild("Students")
        local teachers = workspace:FindFirstChild("Teachers")
        local myChar = LP.Character
        if students and teachers and myChar then
            if char:IsDescendantOf(students) and myChar:IsDescendantOf(students) then return true end
            if char:IsDescendantOf(teachers) and myChar:IsDescendantOf(teachers) then return true end
        end
    end
    return false
end

-- ========== 爱丽丝抓取增大 ==========
local function applyAliceGrab()
    if not AliceGrabEnabled then return end
    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not IsTeammate(p) then
            table.insert(targets, p.Character)
        end
    end
    local myChar = LP.Character
    local myFolder = nil
    if myChar then
        if myChar:IsDescendantOf(workspace:FindFirstChild("Students") or workspace) then
            myFolder = "Students"
        elseif myChar:IsDescendantOf(workspace:FindFirstChild("Teachers") or workspace) then
            myFolder = "Teachers"
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LP.Character then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local player = Players:GetPlayerFromCharacter(obj)
                if not player then
                    local targetFolder = nil
                    if obj:IsDescendantOf(workspace:FindFirstChild("Students") or workspace) then
                        targetFolder = "Students"
                    elseif obj:IsDescendantOf(workspace:FindFirstChild("Teachers") or workspace) then
                        targetFolder = "Teachers"
                    end
                    if myFolder and targetFolder and myFolder == targetFolder then
                        -- 同阵营跳过
                    else
                        table.insert(targets, obj)
                    end
                end
            end
        end
    end
    for _, model in ipairs(targets) do
        local root = model:FindFirstChild("HumanoidRootPart")
        if root then
            local hitbox = model:FindFirstChild("CustomAliceGrab")
            if not hitbox then
                hitbox = Instance.new("Part")
                hitbox.Name = "CustomAliceGrab"
                hitbox.CanCollide = false
                hitbox.Transparency = 1
                hitbox.Anchored = false
                hitbox.Size = root.Size * ALICE_GRAB_SCALE
                hitbox.CFrame = root.CFrame
                hitbox.Parent = model
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = hitbox
                weld.Part1 = root
                weld.Parent = hitbox
            else
                hitbox.Size = root.Size * ALICE_GRAB_SCALE
            end
        end
