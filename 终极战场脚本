            hl.OutlineColor = Color3.new(1,1,1)
            hl.FillTransparency = 0.5
            hl.Adornee = char
            hl.Parent = char

            local bill = Instance.new("BillboardGui")
            bill.AlwaysOnTop = true
            bill.Size = UDim2.new(0, 140, 0, 70)
            bill.StudsOffset = Vector3.new(0, 2.8, 0)
            bill.Adornee = head
            bill.Parent = head

            local txt = Instance.new("TextLabel", bill)
            txt.BackgroundTransparency = 1
            txt.Text = label
            txt.TextColor3 = Color3.new(1,1,1)
            txt.Font = Enum.Font.SourceSansBold
            txt.TextSize = 14
            txt.Size = UDim2.new(1, 0, 0, 18)
            txt.Position = UDim2.new(0, 0, 0, 0)

            local staminaText = Instance.new("TextLabel", bill)
            staminaText.BackgroundTransparency = 1
            staminaText.TextColor3 = Color3.fromRGB(255, 255, 255)
            staminaText.Font = Enum.Font.SourceSans
            staminaText.TextSize = 12
            staminaText.Size = UDim2.new(1, 0, 0, 16)
            staminaText.Position = UDim2.new(0, 0, 0, 18)
            staminaText.Text = "体力: --"

            local rageText = Instance.new("TextLabel", bill)
            rageText.Name = "RageText"
            rageText.BackgroundTransparency = 1
            rageText.TextColor3 = Color3.fromRGB(255, 80, 80)
            rageText.Font = Enum.Font.SourceSansBold
            rageText.TextSize = 12
            rageText.Size = UDim2.new(1, 0, 0, 16)
            rageText.Position = UDim2.new(0, 0, 0, 34)

            local data = {
                Highlight = hl,
                Billboard = bill,
                TextLabel = txt,
                StaminaText = staminaText,
                RageText = rageText
            }
            espObjects[player] = data
        else
            local data = espObjects[player]
            data.Highlight.FillColor = color
            data.TextLabel.Text = label
            data.TextLabel.TextColor3 = Color3.new(1,1,1)
        end

        local data = espObjects[player]
        if data then
            if stamina ~= nil then
                data.StaminaText.Text = "体力: " .. tostring(math.floor(tonumber(stamina) or 0))
            else
