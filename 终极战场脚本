addToggle("服务器延迟检测", ServerPingDisplayEnabled, function(on)
    ServerPingDisplayEnabled = on
    if on then
        spawn(function()
            local srvGui = Instance.new("ScreenGui")
            srvGui.Name = "ServerPingDisplay"
            srvGui.Parent = LP:WaitForChild("PlayerGui")
            srvGui.ResetOnSpawn = false
            srvGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

            local srvLabel = Instance.new("TextLabel", srvGui)
            srvLabel.Size = UDim2.new(0, 240, 0, 20)
            local yPos = PingDisplayEnabled and 35 or 10
            srvLabel.Position = UDim2.new(0, 10, 0, yPos)
            srvLabel.BackgroundTransparency = 1
            srvLabel.Font = Enum.Font.GothamBold
            srvLabel.TextSize = 14
            srvLabel.TextStrokeTransparency = 0
            srvLabel.Text = "检测中..."

            local samples = 10
            local pingHistory = {}

            while ServerPingDisplayEnabled do
                local ping = math.floor(LP:GetNetworkPing() * 1000)
                table.insert(pingHistory, ping)
                if #pingHistory > samples then table.remove(pingHistory, 1) end

                local minPing, maxPing, sumPing = math.huge, -1, 0
                for _, p in ipairs(pingHistory) do
                    minPing = math.min(minPing, p)
                    maxPing = math.max(maxPing, p)
                    sumPing = sumPing + p
                end
                local avgPing = math.floor(sumPing / #pingHistory)
                srvLabel.Text = string.format("平均:%dms | 最低:%dms | 最高:%dms", avgPing, minPing, maxPing)

                if avgPing < 80 then
                    srvLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                elseif avgPing <= 150 then
                    srvLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                else
                    srvLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                end

                task.wait(0.1)
            end
            srvGui:Destroy()
        end)
        notify("服务器延迟检测", "已开启")
    else
        notify("服务器延迟检测", "已关闭")
    end
end)

