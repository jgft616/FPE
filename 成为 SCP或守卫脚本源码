local function addSwitch(parent, text, initial, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -8, 0, 24)
    btn.Text = text .. ": " .. (initial and "开启" or "关闭")
    btn.BackgroundColor3 = initial and ColorPalette.AccentGreen or ColorPalette.AccentRed
    btn.TextColor3 = ColorPalette.TextLight
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    local state = initial
    local lastTap = 0
    local function toggle()
        if tick() - lastTap < 0.3 then return end
        lastTap = tick()
        state = not state
        btn.Text = text .. ": " .. (state and "开启" or "关闭")
        btn.BackgroundColor3 = state and ColorPalette.AccentGreen or ColorPalette.AccentRed
        callback(state)
        notify(text, state and "开启" or "关闭")
    end
    btn.MouseButton1Click:Connect(toggle)
    btn.Activated:Connect(toggle)
    return btn
end

local function addSlider(parent, label, default, formatFunc, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -8, 0, 36)
    frame.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1, 0, 0, 14)
    lbl.Text = label .. ": " .. formatFunc(default)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = ColorPalette.TextGray
    lbl.TextSize = 10
    local box = Instance.new("TextBox", frame)
    box.Size = UDim2.new(1, -8, 0, 20)
    box.Position = UDim2.new(0, 4, 0, 15)
    box.Text = tostring(default)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.BackgroundColor3 = ColorPalette.BackgroundLight
    box.TextColor3 = ColorPalette.TextLight
    local val = default
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            val = num
            lbl.Text = label .. ": " .. formatFunc(num)
            if callback then callback(num) end
        else
            box.Text = tostring(val)
        end
    end)
    return frame
end

