local function createScrollSection(parent, title, defaultOpen, maxHeight)
    local section = Instance.new("Frame", parent)
    section.Size = UDim2.new(1,-4,0,25)
    section.BackgroundColor3 = Color3.fromRGB(40,40,40)
    section.BorderSizePixel = 0
    section.LayoutOrder = 0
    local header = Instance.new("TextButton", section)
    header.Size = UDim2.new(1,0,0,25)
    header.Text = (defaultOpen and "▼ " or "▶ ") .. title
    header.BackgroundColor3 = Color3.fromRGB(50,50,50)
    header.TextColor3 = Color3.new(1,1,1)
    header.Font = Enum.Font.SourceSansBold
    header.TextSize = 13
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.AutoButtonColor = false
    local scroll = Instance.new("ScrollingFrame", section)
    scroll.Size = UDim2.new(1,0,0,0)
    scroll.Position = UDim2.new(0,0,0,25)
    scroll.BackgroundColor3 = Color3.fromRGB(35,35,35)
    scroll.BorderSizePixel = 0
    scroll.Visible = defaultOpen
    scroll.ScrollBarThickness = 6
    scroll.ScrollBarImageColor3 = Color3.fromRGB(80,145,255)
    scroll.ScrollBarImageTransparency = 0.2
    scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.ClipsDescendants = true
    scroll.ElasticBehavior = Enum.ElasticBehavior.Never
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    local innerContent = Instance.new("Frame", scroll)
    innerContent.Size = UDim2.new(1,0,0,0)
    innerContent.BackgroundColor3 = Color3.fromRGB(35,35,35)
    innerContent.BorderSizePixel = 0
    local innerList = Instance.new("UIListLayout", innerContent)
    innerList.SortOrder = Enum.SortOrder.LayoutOrder
    innerList.Padding = UDim.new(0,3)
    local isOpen = defaultOpen
    maxHeight = maxHeight or 220
    local function updateSectionHeight()
        if not isOpen then
            section.Size = UDim2.new(1,-4,0,25)
            return
        end
        local contentHeight = innerList.AbsoluteContentSize.Y + 6
        local displayHeight = math.min(contentHeight, maxHeight)
        scroll.Size = UDim2.new(1,0,0,displayHeight)
        section.Size = UDim2.new(1,-4,0,25+displayHeight)
        scroll.CanvasSize = UDim2.new(0,0,0,contentHeight+10)
    end
    header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        scroll.Visible = isOpen
        header.Text = (isOpen and "▼ " or "▶ ") .. title
        updateSectionHeight()
    end)
    innerList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSectionHeight)
    return innerContent, updateSectionHeight
end

