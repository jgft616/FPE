-- 弹道
local beam, att0, att1, beamTimeout
local function createBeam()
    if beam then return end
    att0 = Instance.new("Attachment", Workspace.Terrain or Workspace)
    att1 = Instance.new("Attachment", Workspace.Terrain or Workspace)
    beam = Instance.new("Beam", Workspace.Terrain or Workspace)
    beam.Attachment0 = att0; beam.Attachment1 = att1
    beam.Color = ColorSequence.new(Color3.fromRGB(255,50,50))
    beam.Width0 = 0.15; beam.Width1 = 0.15; beam.FaceCamera = true; beam.Enabled = false
end
local function showBeamTo(pos)
    if not showBeam then return end
    createBeam()
    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not r then beam.Enabled = false; return end
    att0.WorldPosition = r.Position + Vector3.new(0,1.5,0)
    att1.WorldPosition = pos
    beam.Enabled = true
    if beamTimeout then beamTimeout:Disconnect() end
    beamTimeout = delay(0.2, function() if beam then beam.Enabled = false end end)
end

-- 敌人/队友判定
function isEnemy(player)
    if not player then return false end
    if friendCheckEnabled and friendSet[player.UserId] then return false end
    if teamCheckEnabled and LP.Team and player.Team and LP.Team == player.Team then return false end
    if whitelistEnabled then for _, tn in ipairs(whitelistTeams) do
        local t = Teams:FindFirstChild(tn); if t and player.Team == t then return false end
    end end
    return true
end
local function isAlly(player)
    if not player then return false end
    if teamCheckEnabled and LP.Team and player.Team and LP.Team == player.Team then return true end
    if whitelistEnabled and player.Team then for _, tn in ipairs(whitelistTeams) do
        local t = Teams:FindFirstChild(tn); if t and player.Team == t then return true end
    end end
    return false
end
local function isEnemyPlayer(player) return not isAlly(player) and not (friendCheckEnabled and friendSet[player.UserId]) end

-- 墙壁检测
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist
local function isVisible(targetPlayer)
    local mc = LP.Character; local tc = targetPlayer.Character
    if not mc or not tc then return false end
    local mr = mc:FindFirstChild("HumanoidRootPart")
    local tp = aimHead and tc:FindFirstChild("Head") or tc:FindFirstChild("HumanoidRootPart") or tc:FindFirstChild("Torso")
    if not mr or not tp then return false end
    rayParams.FilterDescendantsInstances = {mc, tc}
    return Workspace:Raycast(mr.Position+Vector3.new(0,1.5,0), tp.Position-mr.Position-Vector3.new(0,1.5,0), rayParams) == nil
end

local function getNearestEnemy()
    local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isEnemy(p) then
            local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if r then local d = (mr.Position - r.Position).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
        end
    end
    return best
end

local function getTargets()
    if not killEnabled then return {} end
    if blacklistEnabled and blacklistPlayerName ~= "" then
        local tp = Players:FindFirstChild(blacklistPlayerName)
        if tp and tp ~= LP and isEnemy(tp) then
            local c = tp.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local part = aimHead and c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
                if part and (not wallCheck or isVisible(tp)) then return {{player=tp, part=part}} end
            end
        end
        return {}
    end
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isEnemy(p) then
            local c = p.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local pt = aimHead and c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
                if pt and (not wallCheck or isVisible(p)) then table.insert(t, {player=p, part=pt}) end
            end
        end
    end
    return t
end

local function getTeleTargets()
    if not teleportEnabled then return {} end
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isEnemy(p) then
            local c = p.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local r = c:FindFirstChild("HumanoidRootPart")
                if r then table.insert(t, r) end
            end
        end
    end
    return t
end

