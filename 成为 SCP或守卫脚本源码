-- 敌人判定
function isEnemy(player)
    if not player then return false end
    if friendCheckEnabled and friendSet[player.UserId] then return false end
    if teamCheckEnabled and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return false end
    if whitelistEnabled then
        for _, teamName in ipairs(whitelistTeams) do
            local team = Teams:FindFirstChild(teamName)
            if team and player.Team == team then return false end
        end
    end
    return true
end

local function isAlly(player)
    if not player then return false end
    if teamCheckEnabled and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
    if whitelistEnabled and player.Team then
        for _, teamName in ipairs(whitelistTeams) do
            local team = Teams:FindFirstChild(teamName)
            if team and player.Team == team then return true end
        end
    end
    return false
end

local function isEnemyPlayer(player)
    return not isAlly(player) and not (friendCheckEnabled and friendSet[player.UserId])
end

-- 墙壁检测
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist
local function isVisible(targetPlayer)
    local myChar = LocalPlayer.Character
    local targetChar = targetPlayer.Character
    if not myChar or not targetChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetPart = aimHead and targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
    if not myRoot or not targetPart then return false end
    local origin = myRoot.Position + Vector3.new(0, 1.5, 0)
    local direction = targetPart.Position - origin
    rayParams.FilterDescendantsInstances = {myChar, targetChar}
    return workspace:Raycast(origin, direction, rayParams) == nil
end

local function getNearestEnemy()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearestPlayer, nearestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isEnemy(player) then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestPlayer = player
                end
            end
        end
    end
    return nearestPlayer
end

-- 攻击目标
local function getTargets()
    if not killEnabled then return {} end
    if blacklistEnabled and blacklistPlayerName ~= "" then
        local targetPlayer = Players:FindFirstChild(blacklistPlayerName)
        if targetPlayer and targetPlayer ~= LocalPlayer and isEnemy(targetPlayer) then
            local char = targetPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local part = aimHead and char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if part and (not wallCheck or isVisible(targetPlayer)) then
                        return { {player = targetPlayer, part = part} }
                    end
                end
            end
        end
        return {}
    end
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isEnemy(player) then
            local char = player.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local part = aimHead and char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if part then
                        if wallCheck and not isVisible(player) then
                        else
                            table.insert(targets, {player = player, part = part})
                        end
                    end
                end
            end
        end
    end
    return targets
end

local function getTeleportTargets()
    if not teleportEnabled then return {} end
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isEnemy(player) then
            local char = player.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then table.insert(targets, root) end
                end
            end
        end
    end
    return targets
end

