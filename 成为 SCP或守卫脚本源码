local espContainer = Instance.new("Folder", game.CoreGui)
espContainer.Name = "MainESP"
local playerESPs = {}

local function createESP(model, color, playerObj)
    if playerESPs[model] then return end
    local highlight = Instance.new("Highlight", espContainer)
    highlight.Adornee = model
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255,255,255)
    highlight.OutlineTransparency = 0
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    local billboard = Instance.new("BillboardGui", espContainer)
    billboard.Adornee = head
    billboard.Size = UDim2.new(0,200,0,40)
    billboard.StudsOffset = Vector3.new(0,2.5,0)
    billboard.AlwaysOnTop = true
    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.new(1,0,0,20)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.new(1,1,1)
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 14
    local infoLabel = Instance.new("TextLabel", billboard)
    infoLabel.Size = UDim2.new(1,0,0,20)
    infoLabel.Position = UDim2.new(0,0,0,20)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.new(1,0.5,0.5)
    infoLabel.TextStrokeTransparency = 0.5
    infoLabel.Font = Enum.Font.SourceSans
    infoLabel.TextSize = 12
    playerESPs[model] = { highlight=highlight, billboard=billboard, nameLabel=nameLabel, infoLabel=infoLabel, player=playerObj, model=model }
end

local function removeESP(model)
    local esp = playerESPs[model]
    if esp then esp.highlight:Destroy(); esp.billboard:Destroy(); playerESPs[model] = nil end
end

local function scanAndUpdateESP()
    for model, esp in pairs(playerESPs) do
        if not model.Parent or not esp.player or not esp.player.Parent then removeESP(model) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local model = player.Character
            local isEnemyCheck = isEnemyPlayer(player)
            local isAllyCheck = isAlly(player)
            local existing = playerESPs[model]
            if enemyESP and isEnemyCheck and not existing then
                createESP(model, Color3.fromRGB(255,0,0), player)
            end
            if allyESP and isAllyCheck and not existing then
                createESP(model, Color3.fromRGB(0,255,0), player)
            end
            if existing then
                local shouldRemove = false
                if existing.highlight.FillColor == Color3.fromRGB(255,0,0) then
                    if not enemyESP or not isEnemyCheck then shouldRemove = true end
                elseif existing.highlight.FillColor == Color3.fromRGB(0,255,0) then
                    if not allyESP or not isAllyCheck then shouldRemove = true end
                end
                if shouldRemove then removeESP(model) end
            end
        end
    end
    for _, esp in pairs(playerESPs) do
        if esp.player and esp.player.Character then
            local hum = esp.player.Character:FindFirstChild("Humanoid")
            local head = esp.player.Character:FindFirstChild("Head")
            if hum and head then
                esp.nameLabel.Text = esp.player.Name
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - head.Position).Magnitude
                    esp.infoLabel.Text = string.format("HP: %.0f | %.0f m", hum.Health, dist)
                end
            end
        end
    end
end

