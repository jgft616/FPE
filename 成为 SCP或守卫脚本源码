-- ESP
local espFolder = Instance.new("Folder", CoreGui)
espFolder.Name = "MainESP"
local playerESPs = {}
local function createESP(model, color, playerObj)
    if playerESPs[model] then return end
    local hl = Instance.new("Highlight", espFolder); hl.Adornee = model; hl.FillColor = color; hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255,255,255); hl.OutlineTransparency = 0
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    local bb = Instance.new("BillboardGui", espFolder); bb.Adornee = head; bb.Size = UDim2.new(0,200,0,40); bb.StudsOffset = Vector3.new(0,2.5,0); bb.AlwaysOnTop = true
    local nl = Instance.new("TextLabel", bb); nl.Size = UDim2.new(1,0,0,20); nl.BackgroundTransparency = 1
    nl.TextColor3 = Color3.new(1,1,1); nl.TextStrokeTransparency = 0.5; nl.Font = Enum.Font.SourceSansBold; nl.TextSize = 14
    local il = Instance.new("TextLabel", bb); il.Size = UDim2.new(1,0,0,20); il.Position = UDim2.new(0,0,0,20); il.BackgroundTransparency = 1
    il.TextColor3 = Color3.new(1,0.5,0.5); il.TextStrokeTransparency = 0.5; il.Font = Enum.Font.SourceSans; il.TextSize = 12
    playerESPs[model] = {hl=hl, bb=bb, nl=nl, il=il, player=playerObj}
end
local function removeESP(model)
    local e = playerESPs[model]; if e then e.hl:Destroy(); e.bb:Destroy(); playerESPs[model] = nil end
end
local function scanESP()
    for model, e in pairs(playerESPs) do if not model.Parent or not e.player or not e.player.Parent then removeESP(model) end end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local model = p.Character; local ec = isEnemyPlayer(p); local ac = isAlly(p)
            local e = playerESPs[model]
            if enemyESP and ec and not e then createESP(model, Color3.fromRGB(255,0,0), p) end
            if allyESP and ac and not e then createESP(model, Color3.fromRGB(0,255,0), p) end
            if e then
                if e.hl.FillColor == Color3.fromRGB(255,0,0) and (not enemyESP or not ec) then removeESP(model) end
                if e.hl.FillColor == Color3.fromRGB(0,255,0) and (not allyESP or not ac) then removeESP(model) end
            end
        end
    end
    for _, e in pairs(playerESPs) do
        if e.player and e.player.Character then
            local h = e.player.Character:FindFirstChild("Humanoid"); local head = e.player.Character:FindFirstChild("Head")
            if h and head then
                e.nl.Text = e.player.Name
                if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (LP.Character.HumanoidRootPart.Position - head.Position).Magnitude
                    e.il.Text = string.format("HP: %.0f | %.0f m", h.Health, dist)
                end
            end
        end
    end
end
spawn(function() while true do scanESP(); wait(espInterval) end end)
