local function createSwitch(parent, text, initial, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1,-10,0,28)
    btn.Text = text .. ": " .. (initial and "开启" or "关闭")
    btn.BackgroundColor3 = initial and Color3.fromRGB(80,180,80) or Color3.fromRGB(180,80,80)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    local enabled = initial
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = text .. ": " .. (enabled and "开启" or "关闭")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(80,180,80) or Color3.fromRGB(180,80,80)
        callback(enabled)
    end)
    return btn
end

local function createSlider(parent, label, default, formatFunc, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1,-10,0,44)
    frame.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1,0,0,18)
    lbl.Text = label .. ": " .. formatFunc(default)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.new(0.9,0.9,0.9)
    lbl.TextSize = 13
    local box = Instance.new("TextBox", frame)
    box.Size = UDim2.new(1,-10,0,25)
    box.Position = UDim2.new(0,5,0,18)
    box.Text = tostring(default)
    box.Font = Enum.Font.SourceSans
    box.TextSize = 13
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            default = num
            lbl.Text = label .. ": " .. formatFunc(num)
            if callback then callback(num) end
        else
            box.Text = tostring(default)
        end
    end)
    return frame
end

