        if killEnabled then
            local targets = getTargets()
            if #targets > 0 then
                statusLabel.Text = "攻击 " .. #targets .. " 个敌人"
                for _, t in ipairs(targets) do
                    shootPlayer(t)
                    task.wait(shootInterval > 0 and shootInterval or 0.01)
                end
            else
                task.wait(0.05)
            end
        else
            task.wait(0.5)
        end
        task.wait(0.05)
    end
end)

